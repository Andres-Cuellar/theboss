---
import Layout from "../layouts/Layout.astro";
import LinkCard from "../components/LinkCard.astro";
import { LINKS, PROFILE, VIDEO_SRC, MARQUEE_WORDS } from "../data/chenzo.links";

const featured = LINKS.filter((l) => l.tier === "featured");
const primary = LINKS.filter((l) => l.tier === "primary");
const social = LINKS.filter((l) => l.tier === "social");
const marqueeRow = [...MARQUEE_WORDS, ...MARQUEE_WORDS];
---

<Layout
  title="Chenzo | The Boss Frenchies"
  description="Pink Chenzo — the smallest pink big rope Isabella & Tan French Bulldog stud. Quality structure, short leg genes. Lock-in open."
  path="/chenzo"
  image="https://assets.cdn.filesafe.space/AK3rMDJ4AS5yCkfu1EPy/media/6ad253c4436f78fefb3ff7b4.jpg"
>
  <!-- ===== Background layer (video-ready) ===== -->
  <div
    class="pointer-events-none fixed inset-0 overflow-hidden"
    aria-hidden="true"
  >
    {
      VIDEO_SRC ? (
        <video
          class="h-full w-full object-cover opacity-40"
          src={VIDEO_SRC}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        />
      ) : null
    }
    <div
      id="aurora-a"
      class="aurora aurora-a -top-32 left-1/2 h-[34rem] w-[54rem] -translate-x-1/2"
    >
    </div>
    <div
      id="aurora-b"
      class="aurora aurora-b top-1/3 -left-40 h-[28rem] w-[28rem]"
    >
    </div>
    <div
      id="aurora-c"
      class="aurora aurora-b -right-40 bottom-0 h-[30rem] w-[30rem]"
    >
    </div>
    <!-- faint vertical grid -->
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 100% 88px;"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-void/60 via-transparent to-void"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-2xl px-5 pb-16">
    <!-- ===== Top bar: logo only ===== -->
    <header data-fade class="flex justify-center py-6">
      <img
        src="/logo-the-boss.jpg"
        alt="The Boss Frenchies LV — logo"
        width="1125"
        height="1125"
        class="h-24 w-24 rounded-3xl object-cover sm:h-28 sm:w-28"
        style="box-shadow: 0 0 40px rgba(196,251,9,0.25), 0 0 90px rgba(20,237,22,0.12);"
      />
    </header>

    <!-- ===== Hero ===== -->
    <section class="pt-6 pb-10 text-center sm:pt-10">
      <p
        data-fade
        class="mx-auto inline-flex items-center gap-2 rounded-full border border-[#c4fb09]/40 bg-[#c4fb09]/10 px-4 py-1.5 text-[11px] font-bold tracking-[0.22em] text-[#c4fb09] uppercase"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#14ed16] opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#14ed16]"
          ></span>
        </span>
        {PROFILE.tagline}
      </p>

      <h1
        aria-label={PROFILE.name}
        class="font-display mt-5 leading-[0.9] uppercase"
        style="font-size: clamp(3.5rem, 10vw, 10rem);"
      >
        {
          PROFILE.name.split(" ").map((word, wi, words) => (
            <span
              aria-hidden="true"
              class:list={[
                "inline-block whitespace-nowrap",
                wi < words.length - 1 && "mr-[0.28em]",
              ]}
            >
              {word.split("").map((ch, ci, chars) => (
                <span aria-hidden="true" class="gsap-mask">
                  <span
                    class:list={[
                      "gsap-hero-char",
                      wi === words.length - 1 &&
                        ci === chars.length - 1 &&
                        "text-boss-gradient",
                    ]}
                  >
                    {ch}
                  </span>
                </span>
              ))}
            </span>
          ))
        }
      </h1>

      <p
        data-fade
        class="font-display text-stroke mt-3 text-2xl tracking-[0.18em] uppercase sm:text-3xl"
      >
        French Bulldog Stud
      </p>

      <!-- ===== Chenzo photo card ===== -->
      <div data-fade class="mx-auto mt-8 max-w-sm">
        <div
          class="bg-boss-gradient rounded-[1.8rem] p-[2px]"
          style="box-shadow: 0 0 60px rgba(196,251,9,0.18);"
        >
          <div class="overflow-hidden rounded-[calc(1.8rem-2px)] bg-black">
            <img
              id="chenzo-photo"
              src="https://assets.cdn.filesafe.space/AK3rMDJ4AS5yCkfu1EPy/media/6ad253c4436f78fefb3ff7b4.jpg"
              alt="Pink Chenzo — Isabella & Tan French Bulldog stud, Las Vegas"
              width="1168"
              height="668"
              class="aspect-auto w-full object-cover object-top"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <p
        data-fade
        class="font-display mt-7 text-2xl tracking-wider uppercase sm:text-3xl"
      >
        {PROFILE.bioLead}
      </p>

      <p
        data-fade
        class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-white/70 sm:text-base"
      >
        {PROFILE.bio}
      </p>

      <div
        data-fade
        class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center"
      >
        <a
          href={featured[0]?.href ?? "#lock-in"}
          class="boss-ping bg-boss-gradient rounded-full px-8 py-4 font-display text-lg tracking-wider text-black uppercase transition-transform duration-300 hover:scale-[1.03]"
        >
          {featured[0]?.label ?? "Lock-In Now"}
        </a>
        <a
          href="tel:+17024150055"
          class="rounded-full border border-white/20 px-8 py-4 font-display text-lg tracking-wider uppercase transition-colors hover:border-[#c4fb09] hover:text-[#c4fb09]"
        >
          Call Now
        </a>
      </div>
    </section>

    <!-- ===== Marquee ===== -->
    <div
      data-fade
      class="relative -mx-5 overflow-hidden border-y border-white/10 bg-black/50 py-3"
    >
      <div id="marquee-track" class="marquee-track items-center gap-8 pr-8">
        {
          [0, 1].map((half) => (
            <div class="flex items-center gap-8" aria-hidden={half === 1}>
              {marqueeRow.map((w) => (
                <span
                  class:list={[
                    "flex items-center gap-8 whitespace-nowrap font-display uppercase",
                    w.includes("$")
                      ? "text-boss-gradient text-base tracking-[0.2em]"
                      : "text-sm tracking-[0.25em] text-white/70",
                  ]}
                >
                  {w} <span class="text-[#c4fb09]">✦</span>
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- ===== Links ===== -->
    <main class="mt-8 flex flex-col gap-3 sm:gap-4">
      <p
        data-fade
        class="font-mono text-[11px] tracking-[0.3em] text-white/40 uppercase"
      >
        // Start here
      </p>

      {featured.map((link) => <LinkCard link={link} index="★" />)}

      <p
        data-fade
        class="mt-4 font-mono text-[11px] tracking-[0.3em] text-white/40 uppercase"
      >
        // Direct contact
      </p>
      {
        primary.map((link, i) => (
          <LinkCard link={link} index={String(i + 2).padStart(2, "0")} />
        ))
      }

      <p
        data-fade
        class="mt-4 font-mono text-[11px] tracking-[0.3em] text-white/40 uppercase"
      >
        // Follow the kennel
      </p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
        {
          social.map((link, i) => (
            <LinkCard link={link} index={String(i + 5).padStart(2, "0")} />
          ))
        }
      </div>
    </main>

    <footer data-fade class="mt-12 text-center">
      <p class="font-display text-xs tracking-[0.3em] text-white/40 uppercase">
        © {new Date().getFullYear()} The Boss Frenchies
      </p>
      <p class="mt-1 text-xs text-white/30">Chenzo · French Bulldog Stud</p>
    </footer>
  </div>

  <script>
    import gsap from "gsap";

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduced) {
      // Entrance timeline
      const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
      tl.from(
        ".gsap-hero-char",
        { yPercent: 115, duration: 1, stagger: 0.06 },
        0.1,
      )
        .from(
          "[data-fade]",
          { y: 26, opacity: 0, duration: 0.8, stagger: 0.08 },
          0.4,
        )
        .from(
          ".link-card",
          { y: 34, opacity: 0, duration: 0.7, stagger: 0.07 },
          0.7,
        );

      // Photo card entrance
      gsap.from("#chenzo-photo", {
        scale: 1.12,
        duration: 1.4,
        ease: "power3.out",
      });

      // Infinite marquee (track holds 2 identical halves)
      gsap.to("#marquee-track", {
        xPercent: -50,
        ease: "none",
        duration: 22,
        repeat: -1,
      });

      // Subtle aurora drift
      gsap.to("#aurora-a", {
        x: 60,
        y: 40,
        duration: 9,
        yoyo: true,
        repeat: -1,
        ease: "sine.inOut",
      });
      gsap.to("#aurora-b", {
        x: -50,
        y: 60,
        duration: 11,
        yoyo: true,
        repeat: -1,
        ease: "sine.inOut",
      });

      // Mouse parallax on desktop
      if (window.matchMedia("(pointer: fine)").matches) {
        const ax = gsap.quickTo("#aurora-a", "x", {
          duration: 1.2,
          ease: "power3.out",
        });
        const ay = gsap.quickTo("#aurora-a", "y", {
          duration: 1.2,
          ease: "power3.out",
        });
        window.addEventListener("mousemove", (e) => {
          ax((e.clientX / window.innerWidth - 0.5) * 80);
          ay((e.clientY / window.innerHeight - 0.5) * 60);
        });
      }
    }
  </script>
</Layout>
